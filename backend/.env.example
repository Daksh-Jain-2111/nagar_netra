JWT_SECRET=super_secret_nagarnetra_dev_key_2026_change_in_prod
DB_PATH=./localdb/nagarnetra.db
UPLOAD_DIR=./localdb/uploads
DEV_MODE=true
OTP_MODE=mock
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
HOST=0.0.0.0
PORT=8000
# AI image classification (civic issue)
AI_CLASSIFIER_PROVIDER=clip_zero_shot
# AI_MODEL_DIR=<absolute path>  (default: backend/ml_models/clip-vit-b16-laion400m)
AI_PRELOAD_MODEL=true
AI_MAX_IMAGES=3
AI_MAX_IMAGE_BYTES=8388608
AI_INFERENCE_TIMEOUT_SECONDS=20
AI_CONFIDENCE_STRONG=0.80
AI_CONFIDENCE_SUGGESTION=0.60
AI_CONFIDENCE_MIN=0.40
# Voice complaints (speech-to-text: offline Whisper; install model with backend/scripts/download_speech_model.py)
STT_PROVIDER=whisper_onnx
# STT_MODEL_DIR=<absolute path>  (default: backend/ml_models/whisper-turbo)
STT_PRELOAD_MODEL=true
STT_TIMEOUT_SECONDS=90
VOICE_MAX_BYTES=10485760
VOICE_MAX_SECONDS=120
