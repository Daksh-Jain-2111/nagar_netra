    {
      "name": "2. Complaints Lifecycle",
      "item": [
        {
          "name": "Create Complaint",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"complaintRef\", jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{citizenToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"cat_pothole\",\n  \"description\": \"Crater in Vishrambag Chowk asphalt\",\n  \"latitude\": 16.8524,\n  \"longitude\": 74.5815,\n  \"address\": \"Vishrambag Chowk, Ward 12 (DEMO)\",\n  \"ward_id\": \"ward_12\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/complaints", "host": ["{{baseUrl}}"], "path": ["complaints"] }
          }
        },
        {
          "name": "Get Complaint By Ref",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{officerToken}}" }],
            "url": { "raw": "{{baseUrl}}/complaints/{{complaintRef}}", "host": ["{{baseUrl}}"], "path": ["complaints", "{{complaintRef}}"] }
          }
        },
        {
          "name": "Update Status (IN_PROGRESS)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{officerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"comment\": \"Officer inspecting site\"\n}" },
            "url": { "raw": "{{baseUrl}}/complaints/{{complaintRef}}/status", "host": ["{{baseUrl}}"], "path": ["complaints", "{{complaintRef}}", "status"] }
          }
        },
        {
          "name": "Update Status (WORK_SCHEDULED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{officerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"WORK_SCHEDULED\",\n  \"comment\": \"Squad scheduled for next morning\"\n}" },
            "url": { "raw": "{{baseUrl}}/complaints/{{complaintRef}}/status", "host": ["{{baseUrl}}"], "path": ["complaints", "{{complaintRef}}", "status"] }
          }
        },
        {
          "name": "Resolve Complaint With Photo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{officerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolution_notes\": \"Pothole permanently repaired.\",\n  \"after_photo_path\": \"/uploads/fixed_demo.jpg\",\n  \"photo_latitude\": 16.8524,\n  \"photo_longitude\": 74.5815\n}"
            },
            "url": { "raw": "{{baseUrl}}/complaints/{{complaintRef}}/resolve", "host": ["{{baseUrl}}"], "path": ["complaints", "{{complaintRef}}", "resolve"] }
          }
        },
        {
          "name": "Reopen Complaint (Within 7 Days)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{citizenToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Asphalt settling unevenly.\"\n}" },
            "url": { "raw": "{{baseUrl}}/complaints/{{complaintRef}}/reopen", "host": ["{{baseUrl}}"], "path": ["complaints", "{{complaintRef}}", "reopen"] }
          }
        },
        {
          "name": "Public Complaint Lookup (Status Only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/complaints/public/{{complaintRef}}", "host": ["{{baseUrl}}"], "path": ["complaints", "public", "{{complaintRef}}"] }
          }
        },
        {
          "name": "Get Duplicate Candidates",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/complaints/NN-2026-000108/duplicate-candidates", "host": ["{{baseUrl}}"], "path": ["complaints", "NN-2026-000108", "duplicate-candidates"] }
          }
        },
        {
          "name": "Verify Danger Flag",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{officerToken}}" }],
            "url": { "raw": "{{baseUrl}}/complaints/{{complaintRef}}/verify-danger", "host": ["{{baseUrl}}"], "path": ["complaints", "{{complaintRef}}", "verify-danger"] }
          }
        },
        {
          "name": "Get Complaint Timeline",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/complaints/{{complaintRef}}/timeline", "host": ["{{baseUrl}}"], "path": ["complaints", "{{complaintRef}}", "timeline"] }
          }
        }
      ]
    },
