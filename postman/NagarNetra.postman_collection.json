    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Citizen OTP Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"mobile\": \"9822014589\",\n  \"corporation_id\": \"SMKMC\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/otp/request", "host": ["{{baseUrl}}"], "path": ["auth", "otp", "request"] }
          }
        },
        {
          "name": "Citizen OTP Verify",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"citizenToken\", jsonData.access_token);"
                ],
                "type": "text/javascript"
